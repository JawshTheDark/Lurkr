{
  "name": "lurker-react-client",
  "desktopName": "lurkr.desktop",
  "private": true,
  "version": "2.7.10",
  "description": "Electron + React desktop client for Lurker IRC with full parity",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Brad Root",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on http://localhost:5173 && LURKER_DEV=1 electron .",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "build:web": "tsc -p tsconfig.json && vite build",
    "package:linux": "npm run build && electron-builder --linux dir --publish never",
    "package:linux:release": "npm run build && electron-builder --linux AppImage tar.gz --x64 --publish never",
    "package:win": "npm run build && electron-builder --win zip --x64 --arm64 --publish never",
    "package:win:x64": "npm run build && electron-builder --win zip --x64 --publish never",
    "package:win:dir": "npm run build && electron-builder --win dir --x64 --publish never",
    "package:win:installer": "npm run build && electron-builder --win nsis portable --x64 --arm64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never",
    "install:linux": "bash ./scripts/install-linux.sh",
    "install:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-windows.ps1 -Build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "start": "npm run build && electron ."
  },
  "build": {
    "appId": "com.lurker.desktop",
    "productName": "Lurkr",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/lurker-icon-512.png",
      "dist/lurker-icon.ico"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "executableName": "lurkr",
      "category": "Network;InstantMessaging;Chat;",
      "icon": "public/lurker-icon-512.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "scripts/install-windows.ps1",
          "to": "install-windows.ps1"
        },
        {
          "from": "scripts/install-windows.bat",
          "to": "install-windows.bat"
        }
      ],
      "icon": "public/lurker-icon.ico",
      "executableName": "Lurkr",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "public/lurker-icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.0",
    "wait-on": "^8.0.3"
  }
}
